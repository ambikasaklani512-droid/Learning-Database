<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        h1 {
            text-align: center;
        }

        span {
            color: rgb(0, 0, 198);
        }

        /* Form Container */
        form {
            max-width: 450px;
            margin: 50px auto;
            padding: 30px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            font-family: Arial, sans-serif;
        }

        /* Labels */
        form label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }

        #username {
            width: 451px;
            height: 43px;
            overflow: hidden;
            resize: none;
        }

        /* Inputs and Textarea */
        form input,
        form select,
        form textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 15px;
            font-weight: 600;
            outline: none;
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        /* Focus Effect */
        form input:focus,
        form select:focus,
        form textarea:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

        /* Submit Button */
        form button {
            width: 100%;
            padding: 12px;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        /* Button Hover */
        form button:hover {
            background: #3730a3;
        }

        /* Responsive */
        @media (max-width: 500px) {
            form {
                margin: 20px;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <h1>ADD USER</h1>
    <form action="/user" method="post">
        <label for="username">Username: </label>
        <textarea name="username" id="username" placeholder="enter your username.."></textarea>
        <label for="email">Email: </label>
        <input type="email" name="email" placeholder="enter your email.." >
        <label for="password">password: </label>
        <input type="password" name="password" placeholder="enter your password..">

        <button type="submit">Add</button>
    </form>
</body>

</html>